{
	admin off
	auto_https off
	persist_config off
	servers {
		protocols h1 h2
	}
}

https://:8443 {
	bind {$BREWERY_BIND:127.0.0.1}
	tls {$BREWERY_TLS_CERT:tls/server.crt} {$BREWERY_TLS_KEY:tls/server.key}

	@outside_lan not remote_ip {$BREWERY_CLIENT_NETS:127.0.0.1/32}
	@wrong_host expression `{http.request.hostport} != "{$BREWERY_HOST:127.0.0.1}:8443" && {http.request.hostport} != "{$BREWERY_ALT_HOST:127.0.0.1}:8443"`
	# Accept origin-form only: Go normalizes Host to the request-target
	# authority in absolute-form requests before Caddy can check it.
	@wrong_target expression `!{http.request.orig_uri}.startsWith("/")`
	@bad_origin {
		header Origin *
		expression `{http.request.header.Origin} != "https://" + {http.request.hostport}`
	}
	@bad_fetch_site {
		header Sec-Fetch-Site *
		expression `{http.request.header.Sec-Fetch-Site} != "same-origin" && {http.request.header.Sec-Fetch-Site} != "none"`
	}
	# Do not let a hop-by-hop Connection option remove a CSRF signal.
	@hop_by_hop_signal expression `{http.request.header.Connection}.matches("(?i)(^|,)[ \t]*(origin|sec-fetch-site|content-type)[ \t]*(,|$)")`
	@has_origin header Origin *
	@no_controller expression `!{http.vars.controller_port}.matches("^[1-9][0-9]{0,4}$") || int({http.vars.controller_port}) > 65535`

	route {
		respond @outside_lan 403
		respond @wrong_host 403
		respond @wrong_target 403
		# The header placeholders include ALL values, rejecting duplicates along
		# with cross-origin, null, empty and comma-separated values.
		respond @bad_origin 403
		respond @bad_fetch_site 403
		respond @hop_by_hop_signal 403
		basic_auth bcrypt "Model Brewery" {
			import basic-auth.caddy
		}

		# The private relay identifies the current controller's loopback port.
		# Capture it once so Host and Origin agree even across controller restarts.
		vars controller_port {file.{$BREWERY_UPSTREAM_SOCKET}.port}
		respond @no_controller 503
		request_header @has_origin Origin http://127.0.0.1:{http.vars.controller_port}
		reverse_proxy unix/{$BREWERY_UPSTREAM_SOCKET} {
			header_up Host 127.0.0.1:{http.vars.controller_port}
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			header_up -Cookie2
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up -X-Real-IP
			flush_interval -1
		}
	}
}
