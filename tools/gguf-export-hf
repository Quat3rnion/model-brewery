COMMIT = "184f6536024668e8908ab8c86033d56708e62b40"
CODE_SHA = "fdb7c0fd39b826727012ba3cd9031818dde766b3b7dc4cc400e67f551a2ca35d"
MIB = 1 << 20
MAX_EXPORT = 512 * MIB
MAX_SCRATCH_EXPORT = 1100 * MIB
MAX_HEADER = 16 * MIB
DTYPE = {"BF16": 2, "F16": 2, "F32": 4, "I64": 8}
ASSETS = frozenset("config.json tokenizer.json tokenizer_config.json chat_template.jinja merges.txt "
                   "generation_config.json vocab.json preprocessor_config.json video_preprocessor_config.json "
                   "special_tokens_map.json added_tokens.json processor_config.json".split())
INDEX = "model.safetensors.index.json"
EXP = {"Qwen4ExpForConditionalGeneration", "Qwen4ExpForCausalLM"}
RECIPE_SCHEMA = "brewery.layer-quant.v1"
# Recipe label -> (GGML tensor type, llama.cpp file type).
RECIPE_TYPES = {"F32": (0, 0), "F16": (1, 1), "BF16": (30, 32), "Q8_0": (8, 7)}


def need(check, reason):
    if not check:
        raise ValueError(reason)


def pairs(items):
    out = {}
    for key, value in items:
        need(key not in out, f"duplicate key: {key}")
        out[key] = value
    return out


def decode(raw):
    def bad(value):
        raise ValueError(f"invalid JSON number: {value}")
    return json.loads(raw, object_pairs_hook=pairs, parse_constant=bad)


def read_json(path):
    with path.open("rb") as src:
        raw = src.read(MAX_HEADER + 1)
    need(len(raw) <= MAX_HEADER, f"oversized JSON: {path.name}")
    result = decode(raw)
    need(isinstance(result, dict), f"expected JSON object: {path.name}")
    return result


def stamp(path):
    return file_stamp(path.lstat(), path.name)


def file_stamp(s, name):
    need(stat.S_ISREG(s.st_mode) and s.st_nlink == 1, f"expected non-aliased regular file: {name}")
    return (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)


def headers(path, size):
    # Buffered reads could prefetch bytes past the header into the tensor payload.
    with path.open("rb", buffering=0) as file:
        raw = file.read(8)
        need(len(raw) == 8, f"truncated safetensors length: {path.name}")
        length, = struct.unpack("<Q", raw)
        need(0 < length <= min(MAX_HEADER, size - 8), f"invalid safetensors header: {path.name}")
        header = decode(file.read(length))
    need(isinstance(header, dict), "invalid safetensors header object")
    meta = header.pop("__metadata__", {})
    need(isinstance(meta, dict) and all(isinstance(v, str) for v in meta.values()), "invalid safetensors metadata")
    need(0 < len(header) <= 32768, "invalid safetensors tensor count")
    spans = []
    tensors = {}
    for name, entry in header.items():
        need(re.fullmatch(r"[A-Za-z0-9_.]{1,255}", name), "invalid tensor name")
        need(isinstance(entry, dict) and set(entry) == {"dtype", "shape", "data_offsets"}, f"invalid tensor descriptor: {name}")
        shape, dtype, offset = entry["shape"], entry["dtype"], entry["data_offsets"]
        need(isinstance(shape, list) and 0 < len(shape) <= 5
             and all(type(x) is int and 0 < x < 1 << 40 for x in shape), f"invalid tensor shape: {name}")
        need(isinstance(offset, list) and len(offset) == 2 and all(type(x) is int for x in offset),
             f"invalid tensor offsets: {name}")
        start, end = offset
        need(isinstance(dtype, str) and dtype in DTYPE and 0 <= start < end <= size - length - 8
             and end - start == math.prod(shape) * DTYPE[dtype], f"invalid tensor bytes or dtype: {name}")
        spans.append((start, end))
        tensors[name] = (dtype, shape)
    end = 0
    for start, stop in sorted(spans):
        need(start == end, f"gaps or overlapping tensor payload: {path.name}")
        end = stop
    need(end == size - length - 8, f"unaccounted bytes in {path.name}")
    return tensors


def selected_paths(source, assets):
    paths = {}
    if assets is not None:
        need(source.suffix == ".safetensors" and source.is_file(), "expected a standalone .safetensors file")
        need(assets.is_absolute() and assets.resolve(strict=True) == assets and assets.is_dir(),
             "assets must be a canonical metadata directory")
        paths["model.safetensors"] = source
    else:
        need(source.is_dir(), "standalone SafeTensors requires a separate --assets directory")
    for path in (assets or source).iterdir():
        need(len(paths) < 512, "too many source files")
        if assets is not None:
            need(path.name in ASSETS, f"unexpected file in metadata directory: {path.name}")
        need(path.name in ASSETS or path.name == INDEX or re.fullmatch(r"[A-Za-z0-9_.-]+\.safetensors", path.name),
             f"unexpected source file (only flat safetensors and allowed metadata): {path.name}")
        paths[path.name] = path
    return paths


def inventory(source, paths=None):
    if paths is None:
        paths = selected_paths(source, None)
    files = {name: stamp(path) for name, path in paths.items()}
    need("config.json" in files, "missing config.json")
    shards = {name for name in files if name.endswith(".safetensors")}
    need(bool(shards), "missing safetensors")
    declared = read_json(paths[INDEX]).get("weight_map") if INDEX in files else None
    need((isinstance(declared, dict) and declared and all(isinstance(v, str) for v in declared.values())
          and set(declared.values()) == shards)
         or (INDEX not in files and shards == {"model.safetensors"}), "invalid or missing shard index")
    config = read_json(paths["config.json"])
    # Never accept source-provided Python dispatch, even if local-only.
    for name in files.keys() & ASSETS:
        need(files[name][2] <= MAX_HEADER, f"oversized asset: {name}")
        if name in ("config.json", "tokenizer_config.json", "processor_config.json"):
            metadata = config if name == "config.json" else read_json(paths[name])
            need("auto_map" not in metadata and "custom_pipelines" not in metadata, f"remote code metadata: {name}")
    names = {}
    tensors = {}
    for file in sorted(shards):
        read = headers(paths[file], files[file][2])
        need(not tensors.keys() & read.keys(), "duplicate tensor across shards")
        need(len(tensors) + len(read) <= 32768, "too many source tensors")
        names.update(dict.fromkeys(read, file))
        tensors.update(read)
    need(declared is None or declared == names, "index/header tensor inventory mismatch")
    return files, config, tensors, names


def qwen2(config, tensors, scratch_private=False, *, llama=False):
    family = "Llama" if llama else "Qwen2"

    def integer(name, maximum):
        value = config.get(name)
        need(type(value) is int and 0 < value <= maximum, f"unsupported {family} {name}")
        return value

    n = integer("num_hidden_layers", 64)
    hidden = integer("hidden_size", 8192)
    heads = integer("num_attention_heads", 128)
    kv = integer("num_key_value_heads", heads)
    ffn = integer("intermediate_size", 32768)
    vocab = integer("vocab_size", 262144)
    tied = config.get("tie_word_embeddings", False)
    need(hidden % heads == heads % kv == 0 and (not tied or (tied is True and scratch_private)),
         f"only dense {family} with integral head sizes is supported; tied weights require a private BF16 export")
    head_dim = hidden // heads
    need(config.get("model_type") == family.lower() and config.get("head_dim", head_dim) == head_dim
         and not any(config.get(key) for key in ("quantization_config", "vision_config", "rope_scaling"))
         and (not llama or (head_dim % 2 == 0 and config.get("hidden_act", "silu") == "silu"
              and not any(config.get(key) for key in ("attention_bias", "mlp_bias", "rope_parameters",
                                                      "draft_vocab_size", "eagle3_config")))),
         f"unsupported {family} configuration")
    expected = {}

    def add(hf, gguf, shape):
        expected[hf] = (gguf, shape)

    add("model.embed_tokens.weight", "token_embd.weight", [vocab, hidden])
    add("model.norm.weight", "output_norm.weight", [hidden])
    if not tied:
        add("lm_head.weight", "output.weight", [vocab, hidden])
    for i in range(n):
        for suffix, gguf, shape in [
            ("input_layernorm.weight", "attn_norm.weight", [hidden]),
            ("post_attention_layernorm.weight", "ffn_norm.weight", [hidden]),
            ("self_attn.o_proj.weight", "attn_output.weight", [hidden, hidden]),
            ("mlp.gate_proj.weight", "ffn_gate.weight", [ffn, hidden]),
            ("mlp.up_proj.weight", "ffn_up.weight", [ffn, hidden]),
            ("mlp.down_proj.weight", "ffn_down.weight", [hidden, ffn]),
        ]:
            add(f"model.layers.{i}.{suffix}", f"blk.{i}.{gguf}", shape)
        for part, width in [("q", hidden), ("k", kv * head_dim), ("v", kv * head_dim)]:
            add(f"model.layers.{i}.self_attn.{part}_proj.weight", f"blk.{i}.attn_{part}.weight", [width, hidden])
            if not llama:
                add(f"model.layers.{i}.self_attn.{part}_proj.bias", f"blk.{i}.attn_{part}.bias", [width])
    need(expected.keys() == tensors.keys(), f"unsupported {family} tensor inventory (missing or additional tensors)")
    source_dtypes = {}
    for name, (gguf, shape) in expected.items():
        dtype, actual = tensors[name]
        need(dtype in ("BF16", "F16", "F32") and shape == actual, f"{family} tensor mismatch: {name}")
        source_dtypes[gguf] = dtype
    return {gguf: dims[::-1] for gguf, dims in expected.values()}, source_dtypes


def gpt2(config, tensors):
    def integer(key, maximum):
        value = config.get(key)
        need(type(value) is int and 0 < value <= maximum, f"invalid GPT-2 {key}")
        return value

    h = integer("n_embd", 4096)
    n = integer("n_layer", 64)
    heads = integer("n_head", 128)
    ctx = integer("n_ctx", 8192)
    vocab = integer("vocab_size", 262144)
    eps = config.get("layer_norm_epsilon")
    need(config.get("model_type") == "gpt2" and h % heads == 0
         and type(eps) in (int, float) and 0 < eps < 1
         and integer("n_positions", 8192) == ctx, "unsupported GPT-2 dimensions or normalization")
    inner = config.get("n_inner")
    need(inner is None or (type(inner) is int and inner == 4 * h), "unsupported GPT-2 n_inner (requires 4 * n_embd)")
    need(config.get("activation_function") == "gelu_new"
         and config.get("scale_attn_weights", True) is True
         and all(config.get(k, False) is False for k in
                 ("scale_attn_by_inverse_layer_idx", "reorder_and_upcast_attn", "add_cross_attention", "is_encoder_decoder"))
         and not any(config.get(k) for k in ("vision_config", "quantization_config", "pruned_heads")),
         "unsupported GPT-2 runtime semantics")
    tied = config.get("tie_word_embeddings")
    need(type(tied) is bool, "GPT-2 tie_word_embeddings must be declared explicitly")
    expected = {}

    def add(src, dest, shape, transposed=False):
        # The pinned GPT-2 exporter transposes Conv1D weights before the
        # GGUF writer reverses tensor dimensions. Other tensors just reverse.
        expected[src] = (dest, shape, shape if transposed else shape[::-1])

    add("transformer.wte.weight", "token_embd.weight", [vocab, h])
    add("transformer.wpe.weight", "position_embd.weight", [ctx, h])
    for suffix in ("weight", "bias"):
        add(f"transformer.ln_f.{suffix}", f"output_norm.{suffix}", [h])
    need(not tied or "lm_head.weight" not in tensors, "ambiguous explicit lm_head with GPT-2 tied embeddings")
    if not tied:
        add("lm_head.weight", "output.weight", [vocab, h])
    for i in range(n):
        for src, dest in (("ln_1", "attn_norm"), ("ln_2", "ffn_norm")):
            for suffix in ("weight", "bias"):
                add(f"transformer.h.{i}.{src}.{suffix}", f"blk.{i}.{dest}.{suffix}", [h])
        for src, dest, dims in (
            ("attn.c_attn", "attn_qkv", [h, 3 * h]), ("attn.c_proj", "attn_output", [h, h]),
            ("mlp.c_fc", "ffn_up", [h, 4 * h]), ("mlp.c_proj", "ffn_down", [4 * h, h]),
        ):
            add(f"transformer.h.{i}.{src}.weight", f"blk.{i}.{dest}.weight", dims, transposed=True)
            add(f"transformer.h.{i}.{src}.bias", f"blk.{i}.{dest}.bias", dims[1:])
    missing, extra = expected.keys() - tensors.keys(), tensors.keys() - expected.keys()
    need(not missing, f"missing GPT-2 tensor: {min(missing, default='')}")
    need(not extra, f"unknown GPT-2 tensor: {min(extra, default='')}")
    source_dtypes = {}
    for name, (dest, shape, _) in expected.items():
        dtype, dims = tensors[name]
        need(dtype in ("F32", "F16", "BF16") and dims == shape, f"GPT-2 tensor shape or dtype mismatch: {name}")
        source_dtypes[dest] = dtype
    return {dest: dims for dest, _, dims in expected.values()}, source_dtypes


def qwen4exp(arch, config, tensors, shard_names):
    """Plan the pinned converter's Flash-Next tensor profile, not runtime admission.

    Recipe axes use source order. Output dimensions use GGML order.
    """
    conditional = arch == "Qwen4ExpForConditionalGeneration"
    text = config.get("text_config", config)
    need(isinstance(text, dict) and text.get("model_type") in ("qwen4_exp_text", "qwen4_exp"),
         "invalid Qwen4Exp text_config")
    need(not any(c.get("quantization_config") or c.get("tie_word_embeddings") for c in (config, text))
         and not text.get("attention_bias") and not text.get("mtp_use_dedicated_embeddings")
         and text.get("output_gate_type", "sigmoid") == "sigmoid",
         "unsupported Qwen4Exp configuration (requires floating, untied, unbiased Flash-Next)")

    def integer(obj, key, maximum=1 << 20, minimum=1):
        value = obj.get(key)
        need(type(value) is int and minimum <= value <= maximum, f"invalid Qwen4Exp {key}")
        return value

    def prefix(candidates, anchor):
        present = [p for p in candidates if p + anchor in tensors]
        need(len(present) == 1,
             f"expected one Qwen4Exp source for {anchor}: {', '.join(p + anchor for p in candidates)}")
        return present[0]

    lm = prefix(("model.language_model.", "model."), "embed_tokens.weight")
    h = integer(text, "hidden_size")
    vocab = integer(text, "vocab_size")
    hc, rank = integer(text, "hc_count", 64), integer(text, "hc_lowrank")
    wide = hc * h
    n = integer(text, "num_hidden_layers", 256)
    qheads = integer(text, "num_attention_heads", 256)
    kvheads = integer(text, "num_key_value_heads", qheads)
    head = integer(text, "head_dim")
    need(qheads % kvheads == 0, "invalid Qwen4Exp attention head counts")
    layers = text.get("layer_types")
    need(isinstance(layers, list) and len(layers) == n
         and all(x in ("full_attention", "linear_attention") for x in layers), "invalid Qwen4Exp layer_types")
    mtp_config = text.get("mtp")
    need(type(text.get("mtp_num_hidden_layers")) is int and text["mtp_num_hidden_layers"] == 1
         and isinstance(mtp_config, dict) and type(mtp_config.get("num_hidden_layers")) is int
         and mtp_config["num_hidden_layers"] == 1 and mtp_config.get("layer_types") == ["full_attention"],
         "only one integrated full-attention Qwen4Exp MTP block is supported")
    ixheads = integer(text, "indexer_n_heads", 256)
    ixhead = integer(text, "indexer_head_dim")
    integer(text, "indexer_budget")
    integer(text, "indexer_compress_ratio")
    integer(text, "indexer_kv_heads", 1)
    experts = integer(text, "num_experts")
    integer(text, "num_experts_per_tok", experts)
    ffn = integer(text, "moe_intermediate_size")
    shared = integer(text, "shared_expert_intermediate_size")

    sources = {}
    model = {"gguf_architecture": "qwen4exp", "tensors": {}, "metadata": {}}
    artifacts = {"model": model}
    target = model["tensors"]
    role = "text"

    def source(name, shape=None, dtype=None):
        need(name in tensors, f"missing Qwen4Exp {role} tensor: {name}")
        actual_dtype, actual_shape = tensors[name]
        need(actual_dtype == dtype if dtype else actual_dtype in ("BF16", "F16", "F32"),
             f"Qwen4Exp tensor {name}: expected {dtype or 'floating dtype'}, got {actual_dtype}")
        need(shape is None or actual_shape == shape, f"Qwen4Exp tensor {name}: expected shape {shape}, got {actual_shape}")
        sources[name] = {"file": shard_names[name], "shape": actual_shape, "dtype": actual_dtype, "role": role}
        return actual_shape

    def op(kind, **parameters):
        return {"op": kind, **parameters}

    def emit(out, shape, names, *ops):
        need(out not in target, f"duplicate Qwen4Exp GGUF tensor: {out}")
        target[out] = {"role": role, "gguf_dimensions": shape[::-1], "sources": names,
                       "operations": list(ops) or [op("copy")]}

    def one(name, out, shape, *ops, dims=None):
        source(name, shape)
        emit(out, shape if dims is None else dims, [name], *ops)

    plus_one = op("add", value=1)

    def hc_mix(src, out, injection=False):
        one(src + "hc_norm.weight", out + "_norm.weight", [wide], plus_one)
        one(src + "input_mix_weight_down.weight", out + "_down.weight", [rank, wide])
        one(src + "input_mix_weight_up.weight", out + "_up.weight", [wide, rank])
        if injection:
            one(src + "block_inject_weight.weight", out + "_inject.weight", [hc, wide])

    def block(src, bid, layer_type):
        out = f"blk.{bid}."
        hc_mix(src + "attn_hyper_connection.", out + "hc_attn", injection=True)
        hc_mix(src + "mlp_hyper_connection.", out + "hc_ffn", injection=True)
        mlp = src + "mlp."
        for name, dest, shape in (
            ("gate.weight", "ffn_gate_inp", [experts, h]),
            ("experts.down_proj", "ffn_down_exps", [experts, h, ffn]),
            ("shared_expert_gate.weight", "ffn_gate_inp_shexp", [1, h]),
            ("shared_expert.gate_proj.weight", "ffn_gate_shexp", [shared, h]),
            ("shared_expert.up_proj.weight", "ffn_up_shexp", [shared, h]),
            ("shared_expert.down_proj.weight", "ffn_down_shexp", [h, shared]),
        ):
            one(mlp + name, out + dest + ".weight", shape)
        gate_up = mlp + "experts.gate_up_proj"
        source(gate_up, [experts, 2 * ffn, h])
        for name, offset in (("gate", 0), ("up", ffn)):
            emit(out + f"ffn_{name}_exps.weight", [experts, ffn, h], [gate_up],
                 op("slice", axis=1, start=offset, length=ffn))

        if layer_type == "full_attention":
            a = src + "self_attn."
            one(a + "q_proj.weight", out + "attn_q.weight", [2 * qheads * head, h])
            one(a + "k_proj.weight", out + "attn_k.weight", [kvheads * head, h])
            one(a + "v_proj.weight", out + "attn_v.weight", [kvheads * head, h])
            one(a + "o_proj.weight", out + "attn_output.weight", [h, qheads * head])
            for part in ("q", "k"):
                one(a + part + "_norm.weight", out + f"attn_{part}_norm.weight", [head], plus_one)
                one(a + f"indexer.{part}_layernorm.weight", out + f"indexer.{part}_norm.weight", [ixhead], plus_one)
            qk = a + "indexer.index_qk_proj.weight"
            ixq = ixheads * ixhead
            source(qk, [ixq + ixhead, h])
            for part, start, length in (("q", 0, ixq), ("k", ixq, ixhead)):
                emit(out + f"indexer.{part}_proj.weight", [length, h], [qk],
                     op("slice", axis=0, start=start, length=length))
            return

        a = src + "linear_attn."
        kh = integer(text, "linear_num_key_heads", 256)
        vh = integer(text, "linear_num_value_heads", 256)
        kd = integer(text, "linear_key_head_dim")
        vd = integer(text, "linear_value_head_dim")
        kernel = integer(text, "linear_conv_kernel_dim", minimum=2)
        need(vh % kh == 0, "invalid Qwen4Exp linear attention head counts")
        qk, v = 2 * kh * kd, vh * vd

        def reorder(axis, width, start=0):
            if kh == vh:
                return ()
            return (op("grouped_to_tiled_value_heads", axis=axis, start=start, key_heads=kh,
                       value_heads_per_key=vh // kh, head_width=width),)

        one(a + "in_proj_qkv.weight", out + "attn_qkv.weight", [qk + v, h], *reorder(0, vd, qk))
        one(a + "in_proj_z.weight", out + "attn_gate.weight", [v, h], *reorder(0, vd))
        one(a + "in_proj_a.weight", out + "ssm_alpha.weight", [vh, h], *reorder(0, 1))
        one(a + "in_proj_b.weight", out + "ssm_beta.weight", [vh, h], *reorder(0, 1))
        one(a + "A_log", out + "ssm_a", [vh], *reorder(0, 1), op("negative_exp"))
        one(a + "dt_bias", out + "ssm_dt.bias", [vh], *reorder(0, 1))
        one(a + "conv1d.weight", out + "ssm_conv1d.weight", [qk + v, 1, kernel],
            op("squeeze", axis=1), *reorder(0, vd, qk), dims=[qk + v, kernel])
        one(a + "norm.weight", out + "ssm_norm.weight", [vd])
        one(a + "out_proj.weight", out + "ssm_out.weight", [h, v], *reorder(1, vd))

    one(lm + "embed_tokens.weight", "token_embd.weight", [vocab, h])
    one("lm_head.weight", "output.weight", [vocab, h])
    hc_mix(lm + "hyper_connection_mixer.", "output_hc")
    for bid, layer in enumerate(layers):
        block(lm + f"layers.{bid}.", bid, layer)

    role = "mtp"
    block("mtp.layers.0.", n, "full_attention")
    nextn = f"blk.{n}.nextn."
    fc = ["mtp.fc_embedding.weight", "mtp.fc_hidden.weight"]
    for name in fc:
        source(name, [h, h])
    emit(nextn + "eh_proj.weight", [h, 2 * h], fc, op("concat", axis=1))
    one("mtp.pre_fc_norm_embedding.weight", nextn + "enorm.weight", [h], plus_one)
    one("mtp.pre_fc_norm_hidden.weight", nextn + "hnorm.weight", [wide], plus_one)
    hc_mix("mtp.hyper_connection_mixer.", nextn + "hc_head")

    role = "engram"
    ple_layers = text.get("ple_layer_ids")
    need(isinstance(ple_layers, list) and len(ple_layers) == 1 and type(ple_layers[0]) is int
         and 1 <= ple_layers[0] <= n, "expected one 1-based Qwen4Exp PLE layer in the trunk")
    ple_layer = ple_layers[0] - 1
    engram = lm + f"layers.{ple_layer}.ple."
    out = f"blk.{ple_layer}.ple_"
    ngram = integer(text, "ngram_size", 64, minimum=2)
    ple_heads = (ngram - 1) * integer(text, "heads_per_ngram", 256)
    ple_embed = integer(text, "ple_embed_dim")
    kernel = integer(text, "ple_conv_kernel_size", minimum=2)
    need(ple_embed % ple_heads == 0, "Qwen4Exp PLE embedding width must be divisible by its head count")
    eos = text.get("eos_token_id")
    need((type(eos) is int and 0 <= eos < vocab) or
         (isinstance(eos, list) and eos and all(type(x) is int and 0 <= x < vocab for x in eos)),
         "invalid Qwen4Exp PLE eos_token_id")
    one(engram + "key_proj.weight", out + "key.weight", [wide, ple_embed])
    one(engram + "value_proj.weight", out + "value.weight", [h, ple_embed])
    for norm in ("key", "query", "conv"):
        one(engram + f"norm_{norm}.weight", out + f"norm_{norm}.weight", [wide], plus_one)
    one(engram + "conv1d.weight", out + "conv1d.weight", [wide, 1, kernel],
        op("squeeze", axis=1), dims=[wide, kernel])
    row_width = ple_embed // ple_heads
    table = engram + "ple_embedding.ngram_embedding."
    parts = [table + f"shard_{i}.weight" for i in range(integer(text, "split_ngram_parts", 512))]
    actual_parts = {name.removeprefix(table) for name in tensors if name.startswith(table)}
    expected_parts = {name.removeprefix(table) for name in parts}
    missing, extra = expected_parts - actual_parts, actual_parts - expected_parts
    if missing or extra:
        issues = ([f"missing {min(missing)}"] if missing else []) + ([f"unexpected {min(extra)}"] if extra else [])
        raise ValueError("Qwen4Exp engram shards must be contiguous and complete: " + "; ".join(issues))
    rows = 0
    for name in parts:
        shape = source(name)
        need(len(shape) == 2 and shape[1] == row_width,
             f"Qwen4Exp engram shard {name}: expected rank 2 and row width {row_width}, got {shape}")
        rows += shape[0]
    emit("per_layer_token_embd.weight", [rows, row_width], parts,
         op("cast", dtype="F32"), op("concat", axis=0))
    # Qwen4ExpTextModel reads hash constants directly as Python ints, and
    # GGUFWriter.add_ple_* writes them as ARRAY<UINT64>, not as float tensors.
    for name, key, count in (
        ("layer_multipliers", "layer_multipliers", ngram),
        ("ngram_heads_offsets", "head_offsets", ple_heads),
        ("ngram_heads_vocab_sizes", "head_vocab_sizes", ple_heads),
    ):
        name = engram + "ple_embedding." + name
        source(name, [count], "I64")
        model["metadata"]["qwen4exp.ple." + key] = {
            "role": role, "sources": [name], "gguf_type": "ARRAY<UINT64>", "element_count": count,
            "operations": [op("exact_integer_values", require_nonnegative=True)], "values_checked": False,
        }

    vision = config.get("vision_config")
    if conditional:
        role = "projector"
        need(isinstance(vision, dict) and not config.get("language_model_only")
             and vision.get("deepstack_visual_indexes", []) == [],
             "only Qwen4Exp vision with no deepstack is supported")
        integer(config, "image_token_id", vocab - 1, minimum=0)
        vis = prefix(("model.visual.", "visual."), "patch_embed.proj.weight")
        size = integer(vision, "hidden_size")
        depth = integer(vision, "depth", 256)
        need(size % integer(vision, "num_heads", size) == 0, "invalid Qwen4Exp vision head counts")
        need(integer(vision, "out_hidden_size") == h, "Qwen4Exp projector output must match text hidden_size")
        ff = integer(vision, "intermediate_size")
        p = integer(vision, "patch_size")
        channels = integer(vision, "in_channels")
        merge = integer(vision, "spatial_merge_size", 64)
        merged = size * merge * merge
        integer(vision, "temporal_patch_size", 2, minimum=2)
        target = {}
        artifacts["mmproj"] = {"gguf_architecture": "clip", "vision_projector_type": "qwen3vl_merger",
                               "tensors": target, "metadata": {}}
        patch = vis + "patch_embed.proj.weight"
        source(patch, [size, channels, 2, p, p])
        for index, suffix in enumerate((".weight", ".weight.1")):
            emit("v.patch_embd" + suffix, [size, channels, p, p], [patch], op("select", axis=2, index=index))
        one(vis + "patch_embed.proj.bias", "v.patch_embd.bias", [size])
        one(vis + "pos_embed.weight", "v.position_embd.weight", [integer(vision, "num_position_embeddings"), size])

        def pair(src, dest, shape):
            one(src + ".weight", dest + ".weight", shape)
            one(src + ".bias", dest + ".bias", shape[:1])

        pair(vis + "merger.norm", "v.post_ln", [size])
        pair(vis + "merger.linear_fc1", "mm.0", [merged, merged])
        pair(vis + "merger.linear_fc2", "mm.2", [h, merged])
        for bid in range(depth):
            src = vis + f"blocks.{bid}."
            out = f"v.blk.{bid}."
            for name, dest, shape in (
                ("attn.qkv", "attn_qkv", [3 * size, size]), ("attn.proj", "attn_out", [size, size]),
                ("mlp.linear_fc1", "ffn_up", [ff, size]), ("mlp.linear_fc2", "ffn_down", [size, ff]),
                ("norm1", "ln1", [size]), ("norm2", "ln2", [size]),
            ):
                pair(src + name, out + dest, shape)
    else:
        need(vision is None, "unexpected vision_config for Qwen4ExpForCausalLM")

    extra = tensors.keys() - sources.keys()
    need(not extra, f"unknown Qwen4Exp source tensor: {min(extra, default='')}")
    return {"schema_version": 1, "scope": "safetensors_header_coverage", "sources": sources, "artifacts": artifacts}


def inspect(source, outtype, paths=None, scratch_private=False):
    files, config, tensors, shard_names = inventory(source, paths)
    architectures = config.get("architectures")
    if "architectures" not in config and config.get("model_type") == "gpt2":
        arch = None
    else:
        need(isinstance(architectures, list) and len(architectures) == 1 and isinstance(architectures[0], str),
             "expected one local HF architecture")
        arch = architectures[0]
    roles = {"text": 0}
    for name in tensors:
        role = ("projector" if name.startswith(("model.visual.", "visual.")) else
                "mtp" if name.startswith("mtp.") else
                "engram" if ".ple_embedding." in name else "text")
        roles[role] = roles.get(role, 0) + 1
    total = sum(s[2] for s in files.values())
    report = {"kind": "inspect", "architecture": arch, "outtype": outtype, "source_tensors": len(tensors),
              "input_bytes": total, "required_roles": sorted(roles), "role_tensor_counts": roles,
              "export_supported": False, "llama_cpp_commit": COMMIT, "tensor_payloads_read": False,
              "export_runtime_checked": False}
    if arch in EXP:
        plan = qwen4exp(arch, config, tensors, shard_names)
        counts = {}
        for entry in plan["sources"].values():
            role = entry["role"]
            counts[role] = counts.get(role, 0) + 1
        report.update(source_coverage_plan=plan, required_roles=sorted(counts), role_tensor_counts=counts,
                      reason="Qwen4Exp sidecar coverage is planned from headers only; export is not proven")
    elif arch in (None, "GPT2Model"):
        report["reason"] = ("GPT-2 GGUF requires an explicit GPT2LMHeadModel architecture; "
                            "an undeclared or bare transformer does not establish a language-model head")
    elif (arch not in ("Qwen2ForCausalLM", "GPT2LMHeadModel")
          and not (scratch_private and arch == "LlamaForCausalLM")):
        report["reason"] = "architecture has no audited offline tensor mapping"
    elif set(roles) != {"text"} or total > (MAX_SCRATCH_EXPORT if scratch_private else MAX_EXPORT):
        report["reason"] = f"only text and at most {1100 if scratch_private else 512} MiB of input are admitted"
    else:
        is_gpt2 = arch == "GPT2LMHeadModel"
        is_llama = arch == "LlamaForCausalLM"
        dims, dtypes = gpt2(config, tensors) if is_gpt2 else qwen2(config, tensors, scratch_private, llama=is_llama)
        report.update(expected_gguf_tensors=dims, source_dtypes=dtypes)
        if not {"tokenizer.json", "tokenizer_config.json"} <= files.keys():
            report["reason"] = "local tokenizer.json and tokenizer_config.json are required"
        else:
            tok = read_json(paths["tokenizer_config.json"] if paths else source / "tokenizer_config.json")
            family = "Llama" if is_llama else "GPT2" if is_gpt2 else "Qwen2"
            tokenizer_class = tok.get("tokenizer_class")
            need(tokenizer_class in (family + "Tokenizer", family + "TokenizerFast")
                 or (is_llama and tokenizer_class == "PreTrainedTokenizerFast")
                 or (is_gpt2 and "tokenizer_class" not in tok),
                 "unsupported tokenizer class")
            schema = read_json(paths["tokenizer.json"] if paths else source / "tokenizer.json")
            tokenizer = schema.get("model")
            need(isinstance(tokenizer, dict) and isinstance(tokenizer.get("vocab"), dict) and bool(tokenizer["vocab"])
                 and (tokenizer.get("type") == "BPE" or
                      (is_gpt2 and "type" not in tokenizer and isinstance(tokenizer.get("merges"), list))),
                 f"expected a local {family} BPE vocabulary")
            if is_gpt2:
                pre = schema.get("pre_tokenizer")
                need(isinstance(pre, dict) and pre.get("type") == "ByteLevel", "expected GPT-2 ByteLevel pre-tokenizer")
                ids = tokenizer["vocab"].values()
                need(all(type(i) is int for i in ids) and len(ids) == config["vocab_size"]
                     and set(ids) == set(range(config["vocab_size"])), "GPT-2 BPE vocabulary does not match model dimensions")
                report["tokenizer_compatibility_checked"] = False
            report["export_supported"] = True
    return report, files


def copy_pinned(root, target):
    def git(*args):
        return subprocess.check_output(
            ["/usr/bin/git", "-C", str(root), *args],
            env={"PATH": "/usr/bin", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
                 "GIT_OPTIONAL_LOCKS": "0"}, timeout=15, text=True,
        ).strip()
    need(git("rev-parse", "HEAD") == COMMIT, "llama.cpp checkout is not at the pinned revision")
    names = git("ls-tree", "-r", "--name-only", COMMIT, "--", "convert_hf_to_gguf.py",
                "conversion", "gguf-py/gguf").splitlines()
    names = [name for name in names if name.endswith(".py")]
    need(len(names) == 124, "llama.cpp Python inventory differs")
    digest = hashlib.sha256()
    for name in sorted(names):
        src = root / name
        need(src.resolve(strict=True) == src and stamp(src)[2] <= 4 * MIB, "invalid pinned exporter file")
        raw = src.read_bytes()
        digest.update(name.encode() + b"\0" + hashlib.sha256(raw).digest())
        dst = target / name
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(raw)
    need(digest.hexdigest() == CODE_SHA, "llama.cpp Python files differ from pin")


def source_identity(files, paths, assets, snapshot=None):
    """Hash the physical source; optionally stage the same bytes for export."""
    tree = hashlib.sha256()
    standalone = None
    for name, expected_stamp in sorted(files.items()):
        size = expected_stamp[2]
        digest = hashlib.sha256()
        with os.fdopen(os.open(paths[name], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as src:
            need(file_stamp(os.fstat(src.fileno()), name) == expected_stamp, f"source changed: {name}")
            dst = (snapshot / name).open("xb") if snapshot is not None else None
            try:
                remaining = size
                while remaining:
                    data = src.read(min(MIB, remaining))
                    need(bool(data), f"source truncated: {name}")
                    digest.update(data)
                    if dst is not None:
                        dst.write(data)
                    remaining -= len(data)
            finally:
                if dst is not None:
                    dst.close()
            need(file_stamp(os.fstat(src.fileno()), name) == expected_stamp, f"source changed: {name}")
        sha = digest.hexdigest()
        if assets is not None and name == "model.safetensors":
            standalone = sha
        else:
            # Same row encoding as weight_safetensors.tree_digest.
            tree.update(f"{name}\0{size}\0{sha}\n".encode("utf-8"))
    if assets is not None:
        return {"source_sha256": standalone, "assets_sha256": tree.hexdigest()}
    return {"source_sha256": tree.hexdigest()}


def compile_layer_recipe(report, recipe):
    need(set(recipe) == {"schema", "source_sha256", "default_type", "layers"}
         and recipe["schema"] == RECIPE_SCHEMA, "invalid layer recipe schema or fields")
    sha = recipe["source_sha256"]
    need(isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{64}", sha)
         and sha == report["source_sha256"], "layer recipe source_sha256 mismatch")
    default, layers = recipe["default_type"], recipe["layers"]
    need(isinstance(default, str) and default in RECIPE_TYPES, "unsupported GGUF default type")
    need(isinstance(layers, dict), "layers must be an object")
    expected = {}
    matched_layers = set()
    for name, dims in report["expected_gguf_tensors"].items():
        if len(dims) == 1 or (report["architecture"] == "GPT2LMHeadModel" and name == "position_embd.weight"):
            kind = report["source_dtypes"][name]
            need(kind == "F32", f"{name}: pinned GGUF recipe requires source F32 (no silent widening)")
        else:
            need(len(dims) == 2 and name.endswith(".weight"), f"unclassified GGUF recipe tensor: {name}")
            layer = re.match(r"blk\.([0-9]+)\.", name)
            layer_id = layer[1] if layer else None
            if layer_id is not None:
                matched_layers.add(layer_id)
            kind = layers.get(layer_id, default)
            need(isinstance(kind, str) and kind in RECIPE_TYPES, f"unsupported GGUF type for {name}")
            need(kind != "Q8_0" or dims[0] % 32 == 0, f"{name}: Q8_0 requires row width divisible by 32")
        expected[name] = RECIPE_TYPES[kind][0]
    need(layers.keys() <= matched_layers, "recipe selects an unknown or noncanonical decoder layer")
    return {**report, "kind": "compile-layer-recipe", "outtype": default.lower(),
            "layer_recipe": recipe, "expected_ggml_types": expected}


def output_tensor_type(name, dims, outtype, arch):
    return 0 if len(dims) == 1 or (arch == "gpt2" and name == "position_embd.weight") else (
        30 if outtype == "bf16" else 1)


def tensor_bytes(dims, dtype):
    if dtype == 8:
        need(dims[0] % 32 == 0, "invalid GGUF Q8_0 row width")
        return math.prod(dims) // 32 * 34
    return math.prod(dims) * (4 if dtype == 0 else 2)


def gguf_inventory(path, outtype, expected, arch="qwen2", expected_types=None):
    size = stamp(path)[2]
    with path.open("rb") as f:
        def raw(n):
            need(n <= 16 * MIB and f.tell() + n <= min(size, 64 * MIB),
                 "GGUF metadata exceeds bounds")
            data = f.read(n)
            need(len(data) == n, "truncated GGUF metadata")
            return data

        def u32():
            return struct.unpack("<I", raw(4))[0]

        def u64():
            return struct.unpack("<Q", raw(8))[0]

        def string():
            return raw(u64()).decode("utf-8")

        scalar = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}

        def value(kind):
            if kind == 8:
                return string()
            if kind == 9:
                item, count = u32(), u64()
                need(count <= 1_000_000 and item in {*scalar, 8}, "invalid GGUF array")
                if item in scalar:
                    raw(scalar[item] * count)
                else:
                    for _ in range(count):
                        string()
                return None
            need(kind in scalar, "unsupported GGUF metadata type")
            return int.from_bytes(raw(scalar[kind]), "little")

        need(raw(4) == b"GGUF" and u32() == 3, "expected GGUF v3")
        count, meta = u64(), u64()
        need(count == len(expected) and meta <= 1024, "unexpected GGUF tensor or metadata count")
        props = {}
        for _ in range(meta):
            key = string()
            need(key not in props, "duplicate GGUF metadata key")
            kind = u32()
            props[key] = (kind, value(kind))
        need(props.get("general.architecture") == (8, arch), "incorrect GGUF architecture")
        need(props.get("general.file_type") == (4, RECIPE_TYPES[outtype.upper()][1]),
             "incorrect GGUF file type")
        tokenizer_models = ((8, "gpt2"), (8, "llama")) if arch == "llama" else ((8, "gpt2"),)
        need(props.get("tokenizer.ggml.model") in tokenizer_models
             and props.get("tokenizer.ggml.tokens", (None,))[0] == 9, "missing GGUF tokenizer")
        need(not any(k.startswith("split.") for k in props), "split output is unsupported")
        align = props.get("general.alignment", (4, 32))
        need(align[0] == 4 and align[1] == 32, "unexpected GGUF alignment")
        spans = []
        types = {}
        for _ in range(count):
            name, rank = string(), u32()
            need(name in expected and name not in types and rank == len(expected[name]), "unexpected GGUF tensor")
            dims = [u64() for _ in range(rank)]
            dtype, offset = u32(), u64()
            wanted = expected_types[name] if expected_types is not None else output_tensor_type(name, dims, outtype, arch)
            need(dims == expected[name] and dtype == wanted and offset % 32 == 0,
                 f"GGUF tensor shape/type/alignment mismatch: {name}")
            end = offset + tensor_bytes(dims, dtype)
            spans.append((offset, end))
            types[name] = {"shape": dims, "ggml_type": dtype}
        start = (f.tell() + 31) & ~31
        end = 0
        for offset, stop in sorted(spans):
            need(offset == (end + 31) & ~31, "GGUF tensor gap or overlap")
            end = stop
        need(size - start in {end, (end + 31) & ~31}, "GGUF payload size mismatch")
    return types


def export(source, output, report, files, paths, assets, scratch_private=False):
    need(report["export_supported"], report.get("reason", "unsupported source"))
    need(output.is_absolute() and output.parent.resolve(strict=True) == output.parent
         and output.name not in ("", ".", "..") and not os.path.lexists(output),
         "output must be a fresh canonical absolute directory")
    need(not output.is_relative_to(source) and not (assets and output.is_relative_to(assets)), "output overlaps source")
    # Both the converter spool and final GGUF may widen F16/BF16 vectors to F32.
    # Count the known output tensor bytes twice, plus room for metadata.
    arch = {"GPT2LMHeadModel": "gpt2", "LlamaForCausalLM": "llama",
            "Qwen2ForCausalLM": "qwen2"}[report["architecture"]]
    expected_types = report.get("expected_ggml_types")
    output_bytes = sum(tensor_bytes(dims, expected_types[name] if expected_types is not None else
                                   output_tensor_type(name, dims, report["outtype"], arch))
                       for name, dims in report["expected_gguf_tensors"].items())
    required = 2 * output_bytes + 128 * MIB + (report["input_bytes"] if expected_types is not None else 0)
    need(shutil.disk_usage(output.parent).free >= required, f"need {required} bytes of scratch space")
    python = Path(os.environ.get("BREWERY_GGUF_PYTHON", "/usr/bin/python3"))
    llama = Path(os.environ.get("BREWERY_LLAMA_CPP", "/arboretum/llama.cpp"))
    need(python.is_absolute() and python.is_file() and llama.is_absolute() and llama.resolve(strict=True) == llama,
         "invalid operator Python or llama.cpp path")
    with tempfile.TemporaryDirectory(prefix=".gguf-stage-", dir=output.parent) as tmp:
        scratch = Path(tmp)
        code, work, final = (scratch / n for n in ("code", "work", "final"))
        work.mkdir()
        final.mkdir()
        copy_pinned(llama, code)
        command = ["/usr/bin/bwrap", "--unshare-all", "--die-with-parent", "--new-session",
                   "--ro-bind", "/usr", "/usr", "--symlink", "usr/lib", "/lib",
                   "--symlink", "usr/lib", "/lib64", "--proc", "/proc", "--dev", "/dev",
                   "--ro-bind", str(code), "/exporter", "--dir", "/input",
                   "--bind", str(work), "/work", "--chdir", "/work"]
        input_paths = paths
        if expected_types is not None:
            # Mount private copies of the bytes checked against the recipe,
            # not source inodes that can change during conversion.
            snapshot = scratch / "input"
            snapshot.mkdir()
            identities = source_identity(files, paths, assets, snapshot)
            need(all(report[key] == digest for key, digest in identities.items()), "source changed before export")
            input_paths = {name: snapshot / name for name in files}
        # Expose only inventoried filenames. In particular a new pickle or
        # local Python module added to the source cannot enter this namespace.
        for name in sorted(files):
            need(stamp(paths[name]) == files[name], f"source changed: {name}")
            command += ["--ro-bind", str(input_paths[name]), f"/input/{name}"]
        if not python.is_relative_to("/usr"):
            runtime = python.parent.parent
            need(runtime not in map(Path, ("/", "/home", "/opt", "/arboretum", "/mnt", "/usr/local"))
                 and not runtime.is_relative_to(source) and not source.is_relative_to(runtime),
                 "Python must be inside a dedicated operator runtime")
            command += ["--ro-bind", str(runtime), str(runtime)]
            resolved = python.resolve(strict=True)
            need(resolved.is_relative_to(runtime) or resolved.is_relative_to("/usr"), "Python symlink leaves runtime")
        bootstrap = (
            "import runpy,sys,torch; "
            "assert torch.version.cuda is None and torch.version.hip is None, 'CPU-only torch required'; "
            "import transformers; original=transformers.AutoTokenizer.from_pretrained; "
            "transformers.AutoTokenizer.from_pretrained=classmethod(lambda cls,*a,**k:"
            "original(*a,**dict(k,trust_remote_code=False,local_files_only=True))); "
            "sys.path.insert(0,'/exporter'); "
        )
        if expected_types is not None:
            (code / "layer-types.json").write_text(json.dumps(expected_types))
            bootstrap += (
                "import json; from conversion import get_model_class; import gguf; "
                "types=json.load(open('/exporter/layer-types.json')); "
                f"cls=get_model_class({report['architecture']!r}); "
                "cls.tensor_force_quant=lambda self,name,new_name,bid,n_dims:gguf.GGMLQuantizationType(types[new_name]); "
            )
        bootstrap += "sys.argv=sys.argv[1:]; runpy.run_path(sys.argv[0],run_name='__main__')"
        command += ["--", str(python), "-I", "-B", "-c", bootstrap,
                    "/exporter/convert_hf_to_gguf.py", "--disable-mistral-community-chat-template",
                    "--use-temp-file", "--outfile", "/work/model.gguf", "--outtype", report["outtype"], "/input"]
        env = {"PATH": "/usr/bin", "HOME": "/work", "USER": "brewery", "TMPDIR": "/work", "HF_HOME": "/work",
               "HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1", "HF_DATASETS_OFFLINE": "1",
               "CUDA_VISIBLE_DEVICES": "", "OMP_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"}

        def limits():
            ceiling = MAX_SCRATCH_EXPORT if scratch_private else MAX_EXPORT
            resource.setrlimit(resource.RLIMIT_FSIZE, (ceiling * 2 + 64 * MIB,) * 2)
            resource.setrlimit(resource.RLIMIT_AS, (6 << 30,) * 2)
            resource.setrlimit(resource.RLIMIT_NOFILE, (256, 256))

        # Keep exporter stdout separate from the adapter's receipt.
        subprocess.run(command, env=env, stdin=subprocess.DEVNULL, stdout=sys.stderr,
                       check=True, timeout=600, preexec_fn=limits)
        need({n: stamp(p) for n, p in selected_paths(source, assets).items()} == files, "source changed during export")
        model = work / "model.gguf"
        inventory_out = gguf_inventory(model, report["outtype"], report["expected_gguf_tensors"], arch, expected_types)
        with model.open("rb") as f:
            sha256 = hashlib.file_digest(f, "sha256").hexdigest()
            os.fsync(f.fileno())
        size = stamp(model)[2]
        model.rename(final / model.name)
        # Atomic and no-clobber, including a destination appearing during conversion.
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.renameat2(-100, os.fsencode(final), -100, os.fsencode(output), 1):
            err = ctypes.get_errno()
            raise OSError(err, os.strerror(err), str(output))
    return {**report, **({"tokenizer_compatibility_checked": True} if arch == "gpt2" else {}),
             "kind": "export-layer-recipe" if expected_types is not None else "export",
             "tensor_payloads_read": True, "export_runtime_checked": True,
            "exporter_sha256": CODE_SHA,
            "artifact": {"path": str(output / "model.gguf"), "sha256": sha256, "bytes": size},
            "gguf_inventory": inventory_out}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("inspect", "export", "source-digest",
                                              "compile-layer-recipe", "export-layer-recipe"))
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--assets", type=Path, help="explicit config/tokenizer directory for a standalone SafeTensors file")
    parser.add_argument("--outtype", choices=("bf16", "f16"), help="uniform floating type for inspect/export")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--recipe", type=Path, help="source-bound JSON layer recipe")
    parser.add_argument("--scratch-private", action="store_true",
                        help="allow larger and tied models for private standalone BF16 evaluation")
    args = parser.parse_args()
    is_export = args.operation in ("export", "export-layer-recipe")
    layer_recipe = args.operation.endswith("-layer-recipe")
    need_identity = layer_recipe or args.operation == "source-digest"
    if is_export != (args.output is not None):
        parser.error("--output is required for export and export-layer-recipe only")
    if layer_recipe != (args.recipe is not None):
        parser.error("--recipe is required for compile-layer-recipe and export-layer-recipe only")
    if need_identity and args.outtype is not None:
        parser.error("--outtype is only for inspect/export")
    if args.scratch_private and (args.assets is None or need_identity or args.outtype == "f16"):
        parser.error("--scratch-private requires standalone BF16 inspect or export")
    try:
        source = args.source
        need(source.is_absolute() and source.resolve(strict=True) == source, "source must be an absolute canonical path")
        paths = selected_paths(source, args.assets)
        report, files = inspect(source, args.outtype or "bf16", paths, args.scratch_private)
        report["source_format"] = "safetensors" if args.assets else "hf"
        if need_identity:
            need(args.assets is not None or INDEX in files, "layer recipes require indexed HF or standalone SafeTensors")
            need(report["export_supported"], report.get("reason", "unsupported source"))
            report.update(source_identity(files, paths, args.assets),
                          kind="source-digest", tensor_payloads_read=True)
            if layer_recipe:
                report = compile_layer_recipe(report, read_json(args.recipe))
        need({n: stamp(p) for n, p in selected_paths(source, args.assets).items()} == files, "source changed during inspection")
        if is_export:
            report = export(source, args.output, report, files, paths, args.assets, args.scratch_private)
        print(json.dumps(report, sort_keys=True, allow_nan=False))
    except (OSError, ValueError, TypeError, RecursionError, subprocess.SubprocessError) as err:
        sys.exit(f"HF GGUF export blocked: {err}")


if __name__ == "__main__":
    main()
